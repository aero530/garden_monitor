# Copy to /etc/gardyn/web.env, fill in, then `sudo chmod 600 /etc/gardyn/web.env`.
# It holds two secrets.

# --- Required ---------------------------------------------------------------

# The URL your PHONE uses to reach the brain. Invitation links and the one-tap
# Done / Snooze buttons on notifications are built from it, so `localhost` here
# means every button is dead the moment you leave the house.
GARDYN_BASE_URL=https://gardyn.your-tailnet.ts.net

# Shared secret for the agent API (/api/...). The Pi sends the same value.
# Generate with:  openssl rand -hex 32
# Leave it unset and the agent API is closed — no telemetry, no camera frames.
GARDYN_AGENT_TOKEN=

# --- Push -------------------------------------------------------------------

# Container name on the shared podman network, not a host address.
GARDYN_NTFY_URL=http://gardyn-ntfy:8090
# From `ntfy token add gardyn`. Required, because the server denies by default.
GARDYN_NTFY_TOKEN=

# --- Email (optional) -------------------------------------------------------
# Unset means no email, which is a perfectly normal configuration. Only Urgent
# and Critical tasks go out by mail; the daily brief is push-only.
#
# Point this at a relay you already run or already have an account with. Sending
# directly from a residential IP is rejected on reputation by most receivers, no
# matter how correct the message is.
#GARDYN_SMTP_HOST=smtp.example.com
#GARDYN_SMTP_PORT=587
#GARDYN_SMTP_USER=gardyn@example.com
#GARDYN_SMTP_PASSWORD=
# Must be an address the relay will accept as a sender. Getting this wrong is the
# single most common reason mail silently disappears.
#GARDYN_SMTP_FROM=gardyn@example.com
# Only for a relay on localhost or inside the same podman network.
#GARDYN_SMTP_PLAINTEXT=1

# --- Rarely changed ---------------------------------------------------------

# Set by the image already; override only if you move the volume.
#GARDYN_DB=sqlite:///var/lib/gardyn/db/gardyn.db
#GARDYN_DATA_DIR=/var/lib/gardyn
#GARDYN_BIND=0.0.0.0:8080

# Session cookies use the `__Host-` prefix, which browsers reject over plain
# HTTP. Set this ONLY if you are running without TLS and cannot sign in — and
# then fix the TLS instead. With Tailscale you never need it.
#GARDYN_INSECURE_COOKIES=1

RUST_LOG=gardyn_web=info,tower_http=warn
