# Copy to /etc/garden/web.env, fill in, then `sudo chmod 600 /etc/garden/web.env`.
# It holds two secrets.

# --- Required ---------------------------------------------------------------

# The URL your PHONE uses to reach the brain. Invitation links and the one-tap
# Done / Snooze buttons on notifications are built from it, so `localhost` here
# means every button is dead the moment you leave the house.
GARDEN_BASE_URL=https://garden.your-tailnet.ts.net

# Shared secret for the agent API (/api/...). The Pi sends the same value.
# Generate with:  openssl rand -hex 32
# Leave it unset and the agent API is closed — no telemetry, no camera frames.
GARDEN_AGENT_TOKEN=

# --- Push -------------------------------------------------------------------

# Container name on the shared podman network, not a host address.
GARDEN_NTFY_URL=http://garden-ntfy:8090
# From `ntfy token add garden`. Required, because the server denies by default.
GARDEN_NTFY_TOKEN=

# --- Email (optional) -------------------------------------------------------
# Unset means no email, which is a perfectly normal configuration. Only Urgent
# and Critical tasks go out by mail; the daily brief is push-only.
#
# Point this at a relay you already run or already have an account with. Sending
# directly from a residential IP is rejected on reputation by most receivers, no
# matter how correct the message is.
#GARDEN_SMTP_HOST=smtp.example.com
#GARDEN_SMTP_PORT=587
#GARDEN_SMTP_USER=garden@example.com
#GARDEN_SMTP_PASSWORD=
# Must be an address the relay will accept as a sender. Getting this wrong is the
# single most common reason mail silently disappears.
#GARDEN_SMTP_FROM=garden@example.com
# Only for a relay on localhost or inside the same podman network.
#GARDEN_SMTP_PLAINTEXT=1

# --- Visual diagnosis (optional) -----------------------------------------------
# A local vision model that writes a sentence about plants the rules have already
# flagged. Unset means off, which is the normal configuration — it wants 8 GB of RAM
# to itself and everything else works without it.
#
# Strictly advisory: it writes text and no rule reads it. Deterministic rules own
# anything that touches dosing, water or an actuator.
#GARDEN_OLLAMA_URL=http://garden-ollama:11434
#GARDEN_OLLAMA_MODEL=qwen2.5vl:7b

# --- Retention ---------------------------------------------------------------
# How long camera frames are kept is a *per-garden* setting in the web UI, under
# Storage, because it is the only thing here that grows without bound and the right
# answer differs per garden. These two are server-wide.
#GARDEN_RETAIN_READING_DAYS=90
#GARDEN_RETAIN_METRIC_DAYS=400

# --- Rarely changed ---------------------------------------------------------

# Set by the image already; override only if you move the volume.
#GARDEN_DB=sqlite:///var/lib/garden/db/garden.db
#GARDEN_DATA_DIR=/var/lib/garden
#GARDEN_BIND=0.0.0.0:8080

# Session cookies use the `__Host-` prefix, which browsers reject over plain
# HTTP. Set this ONLY if you are running without TLS and cannot sign in — and
# then fix the TLS instead. With Tailscale you never need it.
#GARDEN_INSECURE_COOKIES=1

RUST_LOG=garden_web=info,tower_http=warn
