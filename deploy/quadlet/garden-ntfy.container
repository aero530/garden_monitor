# Self-hosted push. This is the channel that actually reaches your phone.
#
# Install to /etc/containers/systemd/garden-ntfy.container

[Unit]
Description=ntfy push server for the garden
Documentation=https://docs.ntfy.sh/config/
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/binwiederhier/ntfy:v2
Exec=serve
# Deliberately not published to the host. Caddy reaches it by container name over the
# shared network and owns the only port the router forwards, so there is exactly one
# internet-facing process and it is not this one. See DESIGN.md §10.
Volume=/etc/garden/ntfy-server.yml:/etc/ntfy/server.yml:Z,ro
Volume=/var/lib/garden-ntfy:/var/lib/ntfy:Z
Volume=/var/cache/garden-ntfy:/var/cache/ntfy:Z
Network=garden.network
# ntfy's image runs as root by default; it has no need to.
User=1000:1000
NoNewPrivileges=true

# Pinned to the v2 tag rather than :latest, and updated on purpose. `podman
# auto-update` will pull a new v2.x when one appears.
AutoUpdate=registry

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
