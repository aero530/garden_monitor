# Self-hosted push. This is the channel that actually reaches your phone.
#
# Install to /etc/containers/systemd/garden-ntfy.container

[Unit]
Description=ntfy push server for the garden
Documentation=https://docs.ntfy.sh/config/
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/binwiederhier/ntfy:v2
Exec=serve
# Published on the LAN, because something has to be able to reach it.
#
# Three deployments, and this line is right for two of them:
#
#   1. **LAN only** (the default, and where you start): the phone talks to this
#      directly on wifi. Notifications arrive at home and nothing is exposed.
#   2. **Fronted by a reverse proxy on another host** — one that already owns 80 and
#      443 for your other services. Point a vhost at this address and drop
#      `garden-caddy` entirely.
#   3. **Fronted by `garden-caddy` on this VM**: Caddy reaches ntfy by container name
#      over the shared network, so this line is redundant. Harmless, or comment it out
#      to keep the surface at exactly one port.
#
# Bound to the LAN address rather than 0.0.0.0. On a single-homed VM those are the same
# thing, and they stop being so the moment you add a second network — at which point
# the narrower one is the one you wish you had written. Adjust to your address.
PublishPort=192.168.86.10:8090:8090
Volume=/etc/garden/ntfy-server.yml:/etc/ntfy/server.yml:Z,ro
Volume=/var/lib/garden-ntfy:/var/lib/ntfy:Z
Volume=/var/cache/garden-ntfy:/var/cache/ntfy:Z
Network=garden.network
# ntfy's image runs as root by default; it has no need to.
User=1000:1000
NoNewPrivileges=true

# Pinned to the v2 tag rather than :latest, and updated on purpose. `podman
# auto-update` will pull a new v2.x when one appears.
AutoUpdate=registry

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
