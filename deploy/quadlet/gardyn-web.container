# The brain: web UI, rule engine, notification dispatcher.
#
# Install to /etc/containers/systemd/gardyn-web.container
# Then:  sudo systemctl daemon-reload && sudo systemctl start gardyn-web

[Unit]
Description=Gardyn brain
Documentation=https://github.com/aero530/garden_monitor
After=network-online.target
Wants=network-online.target
# Start after ntfy so the first notification sweep has somewhere to deliver. This
# is ordering only, not a dependency: the brain runs fine with push unavailable and
# says so on the settings page.
After=gardyn-ntfy.service
# A failure to find the image should keep retrying rather than trip systemd's
# start limit and leave the service down until someone notices.
StartLimitIntervalSec=0

[Container]
Image=localhost/gardyn-web:latest
# Holds GARDYN_AGENT_TOKEN and the SMTP password, so it is a 0600 file rather than
# inline Environment= lines, which `systemctl show` would print to any user.
EnvironmentFile=/etc/gardyn/web.env
PublishPort=8080:8080
# :Z relabels the directory for SELinux, which is enforcing on Fedora. Without it
# the container is denied every read and the log fills with permission errors that
# look nothing like a permissions problem.
Volume=/var/lib/gardyn:/var/lib/gardyn:Z
Network=gardyn.network

# Everything below is hardening. None of it is required to make the service work,
# and all of it limits what a flaw in the image can reach.
User=1000:1000
ReadOnly=true
Tmpfs=/tmp:rw,size=64M,mode=1777
NoNewPrivileges=true
DropCapability=ALL

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
