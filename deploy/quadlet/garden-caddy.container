# TLS terminator for ntfy. The only container that faces the internet.
#
# Install to /etc/containers/systemd/garden-caddy.container
#
# Publishes 443 and 80, and forwards to `garden-ntfy` over the shared podman network
# rather than through the host — which is why `garden-ntfy.container` no longer needs
# to publish 8090 at all. See DESIGN.md §10.

[Unit]
Description=Caddy, TLS for the garden's push server
Documentation=https://caddyserver.com/docs/caddyfile
After=network-online.target garden-ntfy.service
Wants=network-online.target

[Container]
Image=docker.io/library/caddy:2-alpine
PublishPort=443:443
# Only for the Let's Encrypt HTTP challenge. Caddy redirects everything else to HTTPS.
PublishPort=80:80
Volume=/etc/garden/Caddyfile:/etc/caddy/Caddyfile:Z,ro
# Certificates and the ACME account key. Losing this volume means re-issuing on every
# restart, which Let's Encrypt rate-limits.
Volume=/var/lib/garden-caddy:/data:Z
Volume=/var/log/garden-caddy:/var/log/caddy:Z
Network=garden.network

# Binding 443 without running as root.
AddCapability=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

AutoUpdate=registry

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
