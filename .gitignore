target/

# Runtime state written by `cargo run -p garden-web`.
# The database and the camera frames beside it are per-deployment data, not source.
garden.db
garden.db-shm
garden.db-wal
garden-data/

# SD card images. `sdbackup.img` is the factory card, and §5's rollback plan depends on
# it — but it is ~30 GB, so it stays out of git and out of reach of `git add -A`.
*.img

# The dev agent token, generated by run-brain.ps1. A shared secret, and the Pi has
# a copy — it stays out of git for the same reason the deployment one does.
.garden-token
*.log
*.csv